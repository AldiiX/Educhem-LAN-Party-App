@model server.Models.EmailUserRegisterModel
@{
    Layout = "/Views/Emails/_EmailLayout.cshtml";
    ViewData["Title"] = "Nové přihlašovací heslo";
    ViewData["Preheader"] = "K účtu bylo vygenerováno nové heslo do rezervačního systému.";
}
<p style="margin:0 0 12px;color:#171717;line-height:24px">@Model.Greeting,</p>
<p style="margin:0 0 20px;color:#45413b;line-height:24px">@(Model.IsFormal ? "pro Váš účet bylo vygenerováno nové heslo. Přihlaste se údaji níže nebo použijte tlačítko." : "pro tvůj účet bylo vygenerováno nové heslo. Přihlas se údaji níže nebo použij tlačítko.")</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;table-layout:fixed;margin:0 0 20px;border:1px solid #e5e2da;border-radius:8px">
    <tr><td bgcolor="#f7f6f2" style="padding:14px 16px;background-color:#f7f6f2;border-bottom:1px solid #e5e2da">
        <p style="margin:0 0 4px;font-size:12px;line-height:18px;color:#625c50">Přihlašovací e-mail</p>
        <p style="margin:0;font-size:16px;line-height:24px;font-weight:700;color:#171717;word-break:break-all">@Model.Email</p>
    </td></tr>
    <tr><td bgcolor="#fff8e6" style="padding:14px 16px;background-color:#fff8e6">
        <p style="margin:0 0 4px;font-size:12px;line-height:18px;color:#625c50">Heslo</p>
        <p style="margin:0;font-family:Consolas,'Courier New',monospace;font-size:18px;line-height:26px;color:#171717;word-break:break-all">@Model.PasswordNonEncrypted</p>
    </td></tr>
</table>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;margin:0 0 24px">
    <tr><td align="center" bgcolor="#ffb303" style="padding:14px 20px;background-color:#ffb303;border-radius:8px"><a href="@Model.WebLink" style="display:block;color:white;text-decoration:none;font-size:16px;line-height:22px;font-weight:700">Přihlásit se</a></td></tr>
</table>
<p style="margin:0 0 20px;color:#45413b;line-height:24px">@(Model.IsFormal ? "Na otevřené stránce zkontrolujte svůj e-mail a potvrďte přihlášení. Odkaz platí 30 minut a lze jej použít jen jednou." : "Na otevřený stránce zkontroluj svůj e-mail a potvrď přihlášení. Odkaz platí 30 minut a jde použít jen jednou.")</p>
<p style="margin:0;padding-top:18px;border-top:1px solid #ebe8e0;color:#625c50;font-size:13px;line-height:21px">@(Model.IsFormal ? "Máte dotazy? Kontaktujte organizátory nebo navštivte" : "Máš dotazy? Kontaktuj organizátory nebo navštiv") <a href="https://discord.gg/D3a8MJUzgQ" style="color:#805300;font-weight:700;text-decoration:underline">EDUCHEM Discord</a>.</p>
