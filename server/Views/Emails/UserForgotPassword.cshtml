@model server.Models.EmailPasswordResetLinkModel
@{
    Layout = "/Views/Emails/_EmailLayout.cshtml";
    ViewData["Title"] = "Obnova hesla";
    ViewData["Preheader"] = "Odkaz pro nastavení nového hesla platí 15 minut.";
}
<p style="margin:0 0 12px;color:#171717;line-height:24px">@Model.Greeting,</p>
<p style="margin:0 0 20px;color:#45413b;line-height:24px">@(Model.IsFormal ? "obdrželi jsme žádost o obnovu hesla k Vašemu účtu." : "obdrželi jsme žádost o obnovu hesla k tvému účtu.")</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;table-layout:fixed;margin:0 0 20px;border:1px solid #e5e2da;border-radius:8px">
    <tr><td bgcolor="#f7f6f2" style="padding:14px 16px;background-color:#f7f6f2">
        <p style="margin:0 0 4px;font-size:12px;line-height:18px;color:#625c50">Účet</p>
        <p style="margin:0;font-size:16px;line-height:24px;font-weight:700;color:#171717;word-break:break-all">@Model.Email</p>
    </td></tr>
</table>
<p style="margin:0 0 16px;color:#45413b;line-height:24px">@(Model.IsFormal ? "Tlačítkem otevřete stránku, kde si nastavíte nové heslo." : "Tlačítkem otevři stránku, kde si nastavíš nové heslo.")</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;margin:0 0 12px">
    <tr><td align="center" bgcolor="#ffb303" style="padding:14px 20px;background-color:#ffb303;border-radius:8px"><a href="@Model.ResetLink" style="display:block;color:white;text-decoration:none;font-size:16px;line-height:22px;font-weight:700">Nastavit nové heslo</a></td></tr>
</table>
<p style="margin:0 0 24px;text-align:center;font-size:13px;line-height:20px;color:#45413b">Odkaz platí <strong style="color:#171717">15 minut</strong>.</p>
<p style="margin:0;padding-top:18px;border-top:1px solid #ebe8e0;color:#625c50;font-size:13px;line-height:21px">@(Model.IsFormal ? "Pokud jste o obnovu nepožádali, tento e-mail můžete ignorovat. Vaše heslo se nezmění." : "Pokud jsi o obnovu nepožádal/a, tento e-mail můžeš ignorovat. Tvoje heslo se nezmění.")</p>